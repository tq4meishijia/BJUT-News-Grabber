<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CampusNotice.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <!--
      资源加载顺序不可调换：
        1) XamlControlsResources（WinUI 3 系统控件样式 / 系统 ThemeResource）
        2) Colors.xaml     —— ThemeDictionaries：Light / Dark / HighContrast 三套确定值
        3) Brushes.xaml    —— 语义别名 + ThemeShadow
        4) Typography / Spacing / IconGlyphs —— 标量 Token
      组件一律用 {ThemeResource 语义键} 引用，代码零裸 HEX（见 docs/winui3-visual-spec.md §10）。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Brushes.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Spacing.xaml" />
                <ResourceDictionary Source="Themes/IconGlyphs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
