<?xml version="1.0" encoding="utf-8"?>
<!--
  Spacing.xaml —— 视觉规范 §5 / §10.3 间距、圆角、尺寸 Token。
  行高一律 MinHeight（不写死 Height）；断点按 DIP（1008 / 640）。
  超宽窗口内容最大宽 940 / 设置 720；<640 时 100% 宽。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 4/8px 基准网格 -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">20</x:Double>
  <x:Double x:Key="Space6">24</x:Double>
  <x:Double x:Key="Space8">32</x:Double>
  <x:Double x:Key="Space10">40</x:Double>
  <x:Double x:Key="Space12">48</x:Double>

  <!-- 页面边距 -->
  <Thickness x:Key="PagePadding">24,24,24,32</Thickness>
  <Thickness x:Key="CompactPagePadding">12,16,12,24</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="CardPaddingDense">12,10,12,10</Thickness>
  <Thickness x:Key="SettingsCardPadding">16,16,20,16</Thickness>
  <Thickness x:Key="GroupHeaderMargin">0,16,0,8</Thickness>

  <x:Double x:Key="CardGap">8</x:Double>
  <x:Double x:Key="SectionGap">24</x:Double>
  <x:Double x:Key="ContentMaxWidth">940</x:Double>
  <x:Double x:Key="SettingsMaxWidth">720</x:Double>

  <!-- NavigationView -->
  <x:Double x:Key="NavOpenPaneLength">240</x:Double>
  <x:Double x:Key="NavCompactPaneLength">48</x:Double>
  <x:Double x:Key="NavItemHeight">40</x:Double>

  <!-- 命令栏 / 命中区 -->
  <x:Double x:Key="CommandBarHeight">48</x:Double>
  <x:Double x:Key="ButtonMinHeight">32</x:Double>
  <x:Double x:Key="HitTargetMin">32</x:Double>
  <x:Double x:Key="PollButtonMinWidth">120</x:Double>

  <!-- 行高（MinHeight） -->
  <x:Double x:Key="RowNoticeMin">96</x:Double>
  <x:Double x:Key="RowItemMin">56</x:Double>
  <x:Double x:Key="RowSourceMin">88</x:Double>
  <x:Double x:Key="RowSettingMin">48</x:Double>
  <x:Double x:Key="RowInputMin">44</x:Double>
  <x:Double x:Key="FilterItemMinHeight">32</x:Double>
  <x:Double x:Key="GroupHeaderMinHeight">28</x:Double>
  <x:Double x:Key="ChipHeight">21</x:Double>
  <x:Double x:Key="BadgeHeight">20</x:Double>

  <!-- 圆角：全应用只有 2 / 4 / 8 三档 -->
  <CornerRadius x:Key="CornerCard">8</CornerRadius>
  <CornerRadius x:Key="CornerControl">4</CornerRadius>
  <CornerRadius x:Key="CornerChip">4</CornerRadius>
  <CornerRadius x:Key="CornerFlyout">8</CornerRadius>
  <CornerRadius x:Key="CornerDialog">8</CornerRadius>
  <CornerRadius x:Key="CornerNavIndicator">2</CornerRadius>

  <x:Double x:Key="StrokeCard">1</x:Double>
  <x:Double x:Key="StrokeFocus">2</x:Double>
  <x:Double x:Key="StripNotice">3</x:Double>
  <x:Double x:Key="StripSource">4</x:Double>

  <!-- 断点（DIP），由 MainWindow.SizeChanged 按 XamlRoot.Size 判断 -->
  <x:Double x:Key="BreakpointCompact">1008</x:Double>
  <x:Double x:Key="BreakpointMinimal">640</x:Double>

  <!-- 图标尺寸 -->
  <x:Double x:Key="IconNav">16</x:Double>
  <x:Double x:Key="IconInline">14</x:Double>
  <x:Double x:Key="IconEmpty">40</x:Double>

  <!-- 浮层 Z -->
  <x:Double x:Key="ElevationFlyout">32</x:Double>
  <x:Double x:Key="ElevationDialog">64</x:Double>
  <x:Double x:Key="ElevationCard">0</x:Double>
</ResourceDictionary>
