<?xml version="1.0" encoding="utf-8"?>
<!--
  IconGlyphs.xaml —— 视觉规范 §6 / §10.4 图标常量（x:String，组件只引用常量）。

  ⚠️ 落地前必做（视觉规范 §6.1 第 2 条 / §12）：
     用「Segoe Fluent Icons」官方字形表逐项核对下面码位；本文件里的码位取自
     docs/winui3-visual-spec.md §6.2–§6.4 的「参考码位」，仅用于定位，不作为最终依据。
     凡 Symbol 枚举已覆盖的语义（Refresh / Add / Filter / Edit / Delete / Play /
     Cancel / Link / More / Calendar / Setting / Accept / ContactInfo / Admin），
     优先在 XAML 里用 SymbolIcon；本字典主要给 FontIcon 与 code-behind 动态图标使用。
  ⚠️ 码位用 XML 数字字符引用（&#xE787;）书写：XAML 不解析 \uXXXX 转义。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 四页导航（§6.2） -->
  <x:String x:Key="IconRinger">&#xEA8F;</x:String>
  <x:String x:Key="IconCalendar">&#xE787;</x:String>
  <x:String x:Key="IconGlobe">&#xE774;</x:String>
  <x:String x:Key="IconSetting">&#xE713;</x:String>

  <!-- 操作（§6.4） -->
  <x:String x:Key="IconRefresh">&#xE72C;</x:String>
  <x:String x:Key="IconAdd">&#xE710;</x:String>
  <x:String x:Key="IconFilter">&#xE71C;</x:String>
  <x:String x:Key="IconEdit">&#xE70F;</x:String>
  <x:String x:Key="IconDelete">&#xE74D;</x:String>
  <x:String x:Key="IconPlay">&#xE768;</x:String>
  <x:String x:Key="IconMore">&#xE712;</x:String>
  <x:String x:Key="IconLink">&#xE71B;</x:String>
  <x:String x:Key="IconCancel">&#xE711;</x:String>
  <x:String x:Key="IconTag">&#xE8EC;</x:String>
  <x:String x:Key="IconContact">&#xE77B;</x:String>

  <!-- 状态（§6.3） -->
  <x:String x:Key="IconCompleted">&#xE73E;</x:String>
  <x:String x:Key="IconErrorBadge">&#xEA39;</x:String>
  <x:String x:Key="IconClock">&#xE823;</x:String>
  <x:String x:Key="IconWarning">&#xE7BA;</x:String>
  <x:String x:Key="IconInfo">&#xE946;</x:String>

  <!-- 无稳定 Symbol 枚举者（必须核对官方字形表） -->
  <x:String x:Key="IconChevronDown">&#xE70D;</x:String>
  <x:String x:Key="IconSave">&#xE74E;</x:String>
  <x:String x:Key="IconDownload">&#xE896;</x:String>
  <!-- AI 摘要：暂用星形 Segoe MDL2 码位 E734。若采用官方 Sparkle 字形请按字形表替换。 -->
  <x:String x:Key="IconSparkle">&#xE734;</x:String>
  <!-- 凭据 / 账号：暂用盾形 Admin 码位 E7EF。 -->
  <x:String x:Key="IconPermission">&#xE7EF;</x:String>
</ResourceDictionary>
