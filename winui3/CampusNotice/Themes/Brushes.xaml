<?xml version="1.0" encoding="utf-8"?>
<!--
  Brushes.xaml —— 语义别名层 + 浮层阴影 + 卡片样式。

  取舍说明（写进 docs/winui3-engineering.md）：
  * 中性层 / 交互态一律在组件里用 {ThemeResource 系统键} 直接引用，保证深/浅色切换与
    高对比度实时生效，因此这里不把系统键做一层静态别名（StaticResource 别名会在
    主题切换后仍指向旧主题画刷，是本规范明确要避免的行为）。
  * 这里提供少量「仅用于装饰、不承载状态语义」的别名、ThemeShadow 与卡片 Style，
    让四页复用同一套「不透明实色 + 1px 描边 + 圆角 8 + 零投影」容器（视觉规范 §3.4 / §7.3）。
  * C 层语义色（Score* / Deadline* / Source* / InfoBar*）全部来自 Colors.xaml 的
    ThemeDictionaries，组件用 {ThemeResource 键} 引用，代码零裸 HEX。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

  <!-- 浮层阴影：仅 Flyout / TeachingTip (Z=32) 与 ContentDialog (Z=64) 使用，
       卡片一律 Z=0 无投影。配合元素上的 Translation="0,0,32" / "0,0,64" 生效。 -->
  <media:ThemeShadow x:Key="FlyoutThemeShadow" />
  <media:ThemeShadow x:Key="DialogThemeShadow" />

  <!-- 系统别名（装饰用途；状态语义请用上面的 C 层键） -->
  <StaticResource x:Key="ContentLayerBrush" ResourceKey="LayerFillColorDefaultBrush" />
  <StaticResource x:Key="ContentSolidBrush" ResourceKey="SolidBackgroundFillColorBaseBrush" />
  <StaticResource x:Key="DividerBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
  <StaticResource x:Key="SubtlePanelBrush" ResourceKey="SubtleFillColorSecondaryBrush" />

  <!-- 标准卡片：不透明实色 + 1px 描边 + 圆角 8 + 零投影 -->
  <Style x:Key="CardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- 密集行卡片（日程 56 / 数据源 88），内边距 12/10 -->
  <Style x:Key="DenseCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
    <Setter Property="Padding" Value="12,10,12,10" />
  </Style>

  <!-- chip / badge：高 20-21、圆角 4、淡底、无描边投影 -->
  <Style x:Key="ChipBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,2,8,2" />
    <Setter Property="MinHeight" Value="21" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 通知正文展开区：二级面板底、圆角 6、内边距 12 -->
  <Style x:Key="BodyPanelBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- 设置分组卡片 -->
  <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
    <Setter Property="Padding" Value="16,16,20,16" />
  </Style>

  <!-- 全局 InfoBar：圆角 8，最多 1 条 -->
  <Style x:Key="GlobalInfoBarStyle" TargetType="InfoBar">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
</ResourceDictionary>
