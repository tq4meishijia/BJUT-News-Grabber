<?xml version="1.0" encoding="utf-8"?>
<!--
  Colors.xaml —— 视觉规范 §10.1 颜色 Token 汇总表，逐键抄录。
  * Light / Dark：C 层（品牌 / 语义）确定 HEX，唯一允许出现裸 HEX 的文件。
  * HighContrast：C 层全部改映射系统 SystemColor*，禁用自定义 HEX（§9.2）。
  * A 层中性色与 B 层强调色不在此定义：组件直接引用系统 ThemeResource
    （CardBackgroundFillColorDefaultBrush / TextFillColorPrimaryBrush / AccentFillColorDefaultBrush …）。
  * 所有别名必须同时出现在 Light / Dark / HighContrast 三个分支中。
  * ScoreXxxFillBrush / ForegroundBrush / SubtleBrush 三元组供 Helpers/ScorePalette.cs 按档位取色。
-->
