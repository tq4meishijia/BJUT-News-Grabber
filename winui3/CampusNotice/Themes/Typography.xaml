<?xml version="1.0" encoding="utf-8"?>
<!--
  Typography.xaml —— 视觉规范 §4.2 / §10.2 字号阶梯。
  * 字号全部 DIP；中文行高显式 LineHeight（14→20、12→16、11→14、28→36），
    防止 150% 缩放下裁切中文下半部（§9.3）。
  * 数字用固定宽度容器 + 右对齐 + CharacterSpacing=0（§4.1 允许的 tabular figures 退化方案）。
  * 正文 TextWrapping=Wrap，只有单行 meta 才在组件里加 TextTrimming=CharacterEllipsis。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:String x:Key="FontFamilyPrimary">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</x:String>
  <x:String x:Key="FontIconFamily">Segoe Fluent Icons</x:String>
  <x:Int32 x:Key="CharacterSpacingOverline">20</x:Int32>

  <x:Double x:Key="FontPageTitleSize">28</x:Double>
  <x:Double x:Key="FontDialogTitleSize">20</x:Double>
  <x:Double x:Key="FontBodySize">14</x:Double>
  <x:Double x:Key="FontCaptionSize">12</x:Double>
  <x:Double x:Key="FontOverlineSize">11</x:Double>

  <!-- 页面标题 28 / 600 / LH36 -->
  <Style x:Key="FontPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontFamily" Value="{ThemeResource FontFamilyPrimary}" />
  </Style>

  <!-- 对话框 / Expander 标题 20 / 600 / LH28 -->
  <Style x:Key="FontDialogTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 分组标题 / 设置分组标题 14 / 600 / LH20 -->
  <Style x:Key="FontSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="CharacterSpacing" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 卡片标题（未读 / 未完成） 14 / 600 / LH20 -->
  <Style x:Key="FontCardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 卡片标题（已读 / 已完成） 14 / 400 / LH20 -->
  <Style x:Key="FontCardTitleRead" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="FontBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="FontBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- meta / hint / chip / 状态行 / 备注 / URL 12 / 400 / LH16 -->
  <Style x:Key="FontCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 徽标文字 / Overline 11 / 500 / LH14 -->
  <Style x:Key="FontOverline" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="CharacterSpacing" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 数字：tabular 退化方案 = 固定宽度容器 + 右对齐 + 零字距 -->
  <Style x:Key="FontNumeric" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="CharacterSpacing" Value="0" />
    <Setter Property="HorizontalTextAlignment" Value="Right" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
  </Style>

  <Style x:Key="FontNumericLarge" TargetType="TextBlock" BasedOn="{StaticResource FontNumeric}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="28" />
  </Style>

  <!-- 状态行：12px，Polite 播报由组件设置 LiveSetting -->
  <Style x:Key="StatusLineStyle" TargetType="TextBlock" BasedOn="{StaticResource FontCaption}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
