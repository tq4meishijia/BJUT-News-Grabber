<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CampusNotice.Views.NoticesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CampusNotice.Controls"
    xmlns:helpers="using:CampusNotice.Helpers">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolVis" />
        <helpers:StringToVisibilityConverter x:Key="StringVis" />
    </Page.Resources>

    <Grid x:Name="PageRoot" MaxWidth="940" HorizontalAlignment="Left"
          Padding="24,8,24,32">
        <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">

                <!-- 筛选行：三态药丸(全部/重要/未读) + 全部标已读 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="FilterRow" Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="FilterAll" Content="全部 0" Tag="all"
                                      MinHeight="32" Padding="12,4,12,4" CornerRadius="4"
                                      Click="Filter_Click" />
                        <!-- 「重要」阈值 50，三处明示之一：ToolTip + HelpText -->
                        <ToggleButton x:Name="FilterImportant" Content="重要 0" Tag="important"
                                      MinHeight="32" Padding="12,4,12,4" CornerRadius="4"
                                      Click="Filter_Click"
                                      ToolTipService.ToolTip="重要：关注度 ≥ 50（关注 50–69 + 重要 70–100）"
                                      AutomationProperties.HelpText="重要：关注度 ≥ 50（关注 + 重要两档）"
                                      AutomationProperties.Name="重要通知筛选，关注度 ≥ 50" />
                        <ToggleButton x:Name="FilterUnread" Content="未读 0" Tag="unread"
                                      MinHeight="32" Padding="12,4,12,4" CornerRadius="4"
                                      Click="Filter_Click" />
                    </StackPanel>
                    <Button x:Name="ReadAllButton" Grid.Column="1" Content="全部标已读"
                            MinHeight="32" Click="ReadAll_Click"
                            AutomationProperties.Name="全部标已读"
                            ToolTipService.ToolTip="将所有通知标为已读（可撤销）" />
                </Grid>

                <!-- 「重要」激活时常驻说明行（v1.1 §13.2 落点①：筛选行下方 12px Caption，
                     不塞进药丸项；<640 紧凑模式只保留 ToolTip / AutomationProperties.Name） -->
                <TextBlock x:Name="ImportantExplanation"
                           Text="重要 = 关注度 ≥ 50 的通知"
                           Style="{StaticResource FontCaption}"
                           Foreground="{ThemeResource NoticeMetaBrush}"
                           Visibility="Collapsed" />

                <!-- 通知卡片流（MinHeight 96，卡片间距 8，零投影） -->
                <ItemsControl x:Name="NoticeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:NoticeCard Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空态 -->
                <StackPanel x:Name="EmptyState" Spacing="8" Margin="0,40,0,40"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE715;" FontFamily="Segoe Fluent Icons" FontSize="40"
                              Opacity="0.5" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="EmptyTitle" Text="还没有抓到通知。"
                               Style="{StaticResource FontBodyStrong}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyBody"
                               Text="先到「数据源」启用或添加一个源，再点右上角「立即抓取」。"
                               Style="{StaticResource FontCaption}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center">
                        <Button x:Name="EmptyGoSources" Content="查看数据源" MinHeight="32"
                                Click="EmptyGoSources_Click" />
                        <Button x:Name="EmptyPoll" Content="立即抓取" MinHeight="32"
                                Style="{StaticResource AccentButtonStyle}" Click="EmptyPoll_Click" />
                        <Button x:Name="EmptyShowAll" Content="查看全部" MinHeight="32"
                                Visibility="Collapsed" Click="EmptyShowAll_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- 达到后端上限提示 -->
                <TextBlock x:Name="LimitHint" Text="仅显示最近 200 条通知（后端上限）"
                           Style="{StaticResource FontCaption}" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
