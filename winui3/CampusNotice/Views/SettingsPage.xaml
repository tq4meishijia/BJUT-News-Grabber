<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CampusNotice.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CampusNotice.Helpers">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolVis" />
        <helpers:StringToVisibilityConverter x:Key="StringVis" />
    </Page.Resources>

    <Grid x:Name="PageRoot" MaxWidth="720" HorizontalAlignment="Left" Padding="24,8,24,32">
        <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">

                <TextBlock x:Name="DirtyHint" Text="有未保存的更改，记得点对应分组的「保存」。"
                           Style="{StaticResource FontCaption}"
                           Foreground="{ThemeResource InfoBarWarningBrush}"
                           Visibility="Collapsed" />

                <!-- ① 抓取与关键词：显式一次性保存 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="抓取与关键词" Style="{StaticResource FontSectionTitle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="24" MinHeight="44" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="抓取间隔（分钟）" Style="{StaticResource FontBody}" VerticalAlignment="Center" />
                                <NumberBox x:Name="PollMinutesBox" Grid.Row="0" Grid.Column="1" Minimum="5" Maximum="1440"
                                           SpinButtonPlacementMode="Compact" MinHeight="32"
                                           ValueChanged="Number_MarkDirty" AutomationProperties.Name="抓取间隔，最少 5 分钟" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="关注关键词" Style="{StaticResource FontBody}" />
                                    <TextBlock Text="顿号/逗号/空白分隔，最多 200 项；清空会影响重要度评分" Style="{StaticResource FontCaption}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="KeywordsBox" Grid.Row="1" Grid.Column="1" MinHeight="60" MaxHeight="120"
                                         TextWrapping="Wrap" AcceptsReturn="True" PlaceholderText="奖助学金, 四六级, 选课, 考试"
                                         TextChanged="Text_MarkDirty" AutomationProperties.Name="关注关键词" />

                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="自动建日程提醒档位" Style="{StaticResource FontBody}" />
                                    <TextBlock Text="分钟数组，逗号分隔，默认 1440,120（提前 1 天 + 2 小时）" Style="{StaticResource FontCaption}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="AutoRemindBox" Grid.Row="2" Grid.Column="1" MinHeight="32"
                                         PlaceholderText="1440,120" TextChanged="Text_MarkDirty" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="每轮最多 AI 摘要条数" Style="{StaticResource FontBody}" VerticalAlignment="Center" />
                                <NumberBox x:Name="LlmMaxBox" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="40" MinHeight="32"
                                           SpinButtonPlacementMode="Compact" ValueChanged="Number_MarkDirty" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="每轮最多跟进详情条数" Style="{StaticResource FontBody}" VerticalAlignment="Center" />
                                <NumberBox x:Name="DetailLimitBox" Grid.Row="4" Grid.Column="1" Minimum="5" Maximum="60" MinHeight="32"
                                           SpinButtonPlacementMode="Compact" ValueChanged="Number_MarkDirty" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="每个数据源最多抓取条数" Style="{StaticResource FontBody}" VerticalAlignment="Center" />
                                <NumberBox x:Name="MaxItemsBox" Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="200" MinHeight="32"
                                           SpinButtonPlacementMode="Compact" ValueChanged="Number_MarkDirty" />
                            </Grid>

                            <TextBlock x:Name="Group1Error" Style="{StaticResource FontCaption}"
                                       Foreground="{ThemeResource InfoBarErrorBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                            <Button x:Name="SaveGroup1" Content="保存设置" MinHeight="32" HorizontalAlignment="Right"
                                    Style="{StaticResource AccentButtonStyle}" Click="SaveGroup1_Click"
                                    AutomationProperties.Name="保存抓取与关键词设置，快捷键 Ctrl 加 S" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ② 行为开关：即时保存（防抖 + 串行 + 在途禁用），无保存按钮 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="行为开关" Style="{StaticResource FontSectionTitle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Style="{StaticResource SettingsCardStyle}" Padding="0">
                        <StackPanel>
                            <Grid Padding="16,12,20,12" MinHeight="48" ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="新通知用 AI 摘要" Style="{StaticResource FontBody}" />
                                    <TextBlock Text="关掉后走规则摘要，不消耗 API Key；已生成的 AI 摘要保留" Style="{StaticResource FontCaption}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ToggleLlm" MinHeight="32" Toggled="Toggle_Toggled" Tag="llm"
                                                  AutomationProperties.Name="新通知用 AI 摘要" />
                                    <ProgressRing x:Name="RingLlm" Width="14" Height="14" IsActive="False"
                                                  Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                            <Grid Padding="16,12,20,12" MinHeight="48" ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="自动建成日程" Style="{StaticResource FontBody}" />
                                    <TextBlock Text="通知里识别到截止时间时自动建成日程；关掉后只能手动「加入日程」" Style="{StaticResource FontCaption}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ToggleAutoSchedule" MinHeight="32" Toggled="Toggle_Toggled" Tag="autoSchedule"
                                                  AutomationProperties.Name="自动建成日程" />
                                    <ProgressRing x:Name="RingAutoSchedule" Width="14" Height="14" IsActive="False"
                                                  Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                            <Grid Padding="16,12,20,12" MinHeight="48" ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="跟进详情页正文" Style="{StaticResource FontBody}" />
                                    <TextBlock Text="更准，但每次抓取会多几个请求；也可在设置底部手动「补齐通知正文」" Style="{StaticResource FontCaption}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ToggleFetchDetail" MinHeight="32" Toggled="Toggle_Toggled" Tag="fetchDetail"
                                                  AutomationProperties.Name="跟进详情页正文" />
                                    <ProgressRing x:Name="RingFetchDetail" Width="14" Height="14" IsActive="False"
                                                  Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                            <Grid Padding="16,12,20,12" MinHeight="48" ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="到点弹桌面通知" Style="{StaticResource FontBody}" />
                                    <TextBlock Text="Windows 系统通知；关掉后仍会在应用内状态行与日程分组里显示，只是不弹系统通知" Style="{StaticResource FontCaption}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ToggleNotify" MinHeight="32" Toggled="Toggle_Toggled" Tag="notify"
                                                  AutomationProperties.Name="到点弹桌面通知" />
                                    <ProgressRing x:Name="RingNotify" Width="14" Height="14" IsActive="False"
                                                  Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ③ 自动登录（CAS）：凭据一律 PasswordBox 不回显 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="自动登录（CAS）" Style="{StaticResource FontSectionTitle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton x:Name="BackLink" Content="返回上一页" Padding="0" FontSize="12"
                                         Visibility="Collapsed" Click="BackLink_Click" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="24" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="认证入口地址 casBase" Style="{StaticResource FontBody}" VerticalAlignment="Center" />
                                <TextBox x:Name="CasBaseBox" Grid.Row="0" Grid.Column="1" MinHeight="32" PlaceholderText="https://..." />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="登录后返回地址 service" Style="{StaticResource FontBody}" VerticalAlignment="Center" />
                                <TextBox x:Name="ServiceBox" Grid.Row="1" Grid.Column="1" MinHeight="32" PlaceholderText="https://..." />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="学号 username" Style="{StaticResource FontBody}" VerticalAlignment="Center" />
                                <TextBox x:Name="UsernameBox" Grid.Row="2" Grid.Column="1" MinHeight="32" PlaceholderText="学号" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="密码 password" Style="{StaticResource FontBody}" VerticalAlignment="Center" />
                                <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" MinHeight="32"
                                             PlaceholderText="已保存（留空不修改）"
                                             AutomationProperties.Name="校园账号密码，不回显明文" />
                            </Grid>
                            <TextBlock Text="密码用 Windows DPAPI 加密存在本机配置文件，只有当前 Windows 用户能解；换电脑或换 Windows 用户需要重新保存一次。遇到验证码会自动退回手动更新登录态。"
                                       Style="{StaticResource FontCaption}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="AccountStatus" Style="{StaticResource FontCaption}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="AccountError" Style="{StaticResource FontCaption}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource InfoBarErrorBrush}" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="AccountTestButton" Content="测试自动登录" MinHeight="32" Click="AccountTest_Click" />
                                <Button x:Name="AccountClearButton" Content="清除已保存" MinHeight="32" Click="AccountClear_Click" />
                                <Button x:Name="AccountSaveButton" Content="保存并登录" MinHeight="32"
                                        Style="{StaticResource AccentButtonStyle}" Click="AccountSave_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ④ AI 摘要 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="AI 摘要" Style="{StaticResource FontSectionTitle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="API Key" Style="{StaticResource FontBody}" />
                                    <TextBlock Text="本机保存，仅当前 Windows 用户可用；绝不回显明文" Style="{StaticResource FontCaption}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" MinHeight="32"
                                             PlaceholderText="已保存（留空不修改）"
                                             AutomationProperties.Name="API Key，不回显明文" />
                            </Grid>
                            <TextBlock x:Name="LlmStatusText" Style="{StaticResource FontCaption}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LlmError" Style="{StaticResource FontCaption}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource InfoBarErrorBrush}" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="LlmTestButton" Content="测试模型" MinHeight="32" Click="LlmTest_Click" />
                                <Button x:Name="LlmClearButton" Content="清空 Key" MinHeight="32" Click="LlmClear_Click" />
                                <Button x:Name="LlmSaveButton" Content="保存 Key" MinHeight="32"
                                        Style="{StaticResource AccentButtonStyle}" Click="LlmSave_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ⑤ 运行状态（只读 + 触发型 op） -->
                <StackPanel Spacing="8">
                    <TextBlock Text="运行状态" Style="{StaticResource FontSectionTitle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="RuntimeText" Style="{StaticResource FontCaption}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <InfoBar x:Name="PollErrorInfoBar" Severity="Error" Title="上次抓取失败" IsOpen="False"
                                     IsClosable="False" Style="{StaticResource GlobalInfoBarStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <!-- 客户端 ToastService 自测，不调用 notify.test op -->
                                <Button x:Name="TestToastButton" Content="测试桌面通知" MinHeight="32" Click="TestToast_Click" />
                                <Button x:Name="RescoreButton" Content="按当前关键词重算摘要" MinHeight="32" Click="Rescore_Click" />
                                <Button x:Name="RefillButton" Content="补齐通知正文" MinHeight="32" Click="Refill_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 关闭窗口 ≠ 退出：只描述关闭后的行为，不描述启动行为 -->
                <TextBlock Text="关闭窗口后可在系统托盘找到，程序仍在后台抓取与提醒；要完全停止请在托盘菜单选「退出」。"
                           Style="{StaticResource FontCaption}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
