<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CampusNotice.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CampusNotice.Helpers">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolVis" />
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolVis" Invert="True" />
        <helpers:StringToVisibilityConverter x:Key="StringVis" />
    </Page.Resources>

    <Grid x:Name="PageRoot" MaxWidth="940" HorizontalAlignment="Left" Padding="24,8,24,32">
        <ScrollViewer x:Name="PageScroll" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">

                <!-- 概览行 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PendingCount" Text="共 0 项待办"
                               Style="{StaticResource FontBodyStrong}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SoonCount" Grid.Column="1" Text="0 项 24 小时内到期"
                               Style="{StaticResource FontCaption}" VerticalAlignment="Center"
                               Foreground="{ThemeResource DeadlineSoonBrush}" />
                </Grid>

                <!-- 内联添加表单（折叠时不占位） -->
                <Border x:Name="AddForm" Style="{StaticResource CardBorderStyle}" Padding="16"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="手动添加日程" Style="{StaticResource FontSectionTitle}" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="标题 *" Style="{StaticResource FontCaption}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="时间 *" Style="{StaticResource FontCaption}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="提前提醒档位" Style="{StaticResource FontCaption}" />

                            <TextBox x:Name="AddTitle" Grid.Row="1" Grid.Column="0" PlaceholderText="要做的事"
                                     MinHeight="32" AutomationProperties.Name="日程标题" />
                            <TextBox x:Name="AddDue" Grid.Row="1" Grid.Column="1"
                                     PlaceholderText="2026-11-05 14:30" MinHeight="32"
                                     AutomationProperties.Name="截止时间，格式 年-月-日 时:分" />
                            <ComboBox x:Name="AddRemind" Grid.Row="1" Grid.Column="2" MinHeight="32"
                                      HorizontalAlignment="Stretch" SelectedIndex="0"
                                      SelectionChanged="AddRemind_SelectionChanged"
                                      AutomationProperties.Name="提前提醒档位">
                                <ComboBoxItem Content="提前 1 天 + 2 小时" Tag="1440,120" />
                                <ComboBoxItem Content="提前 2 小时" Tag="120" />
                                <ComboBoxItem Content="准时" Tag="0" />
                                <ComboBoxItem Content="自定义" Tag="custom" />
                            </ComboBox>

                            <TextBox x:Name="AddCustomRemind" Grid.Row="2" Grid.Column="2" MinHeight="32"
                                     PlaceholderText="分钟，逗号分隔" Visibility="Collapsed" />
                            <TextBox x:Name="AddNote" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                     PlaceholderText="备注（可选，最多 600 字）" MinHeight="32"
                                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="80" />

                            <TextBlock x:Name="AddError" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                       Style="{StaticResource FontCaption}" Visibility="Collapsed"
                                       Foreground="{ThemeResource InfoBarErrorBrush}" TextWrapping="Wrap" />

                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right">
                                <Button Content="取消" MinHeight="32" Click="AddCancel_Click" />
                                <Button Content="保存" MinHeight="32" Style="{StaticResource AccentButtonStyle}"
                                        Click="AddSave_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分组列表（顺序：已逾期→今天→明天→本周内→更远→未定时间→(已完成)） -->
                <ItemsControl x:Name="GroupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="8" Margin="0,0,0,16">
                                <!-- 分组头：4px 色条 + 组名 + N，吸顶时不透明底 -->
                                <Grid ColumnSpacing="8" MinHeight="28"
                                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                      Padding="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="4" Height="14" CornerRadius="2"
                                            Background="{Binding HeaderFill}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Style="{StaticResource FontSectionTitle}"
                                               Foreground="{Binding HeaderBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Count}"
                                               Style="{StaticResource FontNumeric}" VerticalAlignment="Center"
                                               Foreground="{Binding HeaderBrush}" />
                                </Grid>
                                <!-- 吸顶分组头底部 1px 分隔线 -->
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardBorderStyle}" MinHeight="56"
                                                    Padding="12,10,12,10" Margin="0,0,0,8"
                                                    Opacity="{Binding Opacity}"
                                                    Visibility="{Binding HiddenVisibility}">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 完成 CheckBox：视觉 16px，命中区扩到 32 -->
                                                        <CheckBox Grid.Column="0" MinWidth="32" MinHeight="32"
                                                                  Padding="0" IsChecked="{Binding Done, Mode=OneWay}"
                                                                  Tag="{Binding Id}" Click="Done_Click"
                                                                  AutomationProperties.Name="{Binding CheckBoxName}"
                                                                  VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Style="{StaticResource FontCardTitle}"
                                                                           TextDecorations="{Binding TextDecorations}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <!-- 完成态保底：删除线 + 「已完成」文字，Opacity 不承载语义 -->
                                                                <Border Style="{StaticResource ChipBorderStyle}"
                                                                        Visibility="{Binding DoneTextVisibility}">
                                                                    <TextBlock Text="已完成" Style="{StaticResource FontCaption}"
                                                                               Foreground="{ThemeResource ItemDoneBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource FontCaption}"
                                                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding Note, Converter={StaticResource StringVis}}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <HyperlinkButton Content="查看通知原文 ↗" Padding="0" FontSize="12"
                                                                             Tag="{Binding Id}" Click="OpenNotice_Click"
                                                                             Visibility="{Binding UrlVisibility}"
                                                                             AutomationProperties.Name="来自通知，可打开原文" />
                                                        </StackPanel>

                                                        <!-- chip 组：时间 / 倒计时 / 提醒档位 / 来自通知 -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                                    VerticalAlignment="Center">
                                                            <Border Style="{StaticResource ChipBorderStyle}">
                                                                <TextBlock Text="{Binding TimeText}"
                                                                           Style="{StaticResource FontCaption}" />
                                                            </Border>
                                                            <Border Style="{StaticResource ChipBorderStyle}">
                                                                <TextBlock Text="{Binding CountdownText}"
                                                                           Style="{StaticResource FontCaption}" />
                                                            </Border>
                                                            <Border Style="{StaticResource ChipBorderStyle}">
                                                                <TextBlock Text="{Binding RemindText}"
                                                                           Style="{StaticResource FontCaption}" />
                                                            </Border>
                                                            <Border Style="{StaticResource ChipBorderStyle}"
                                                                    Visibility="{Binding FromNoticeVisibility}">
                                                                <TextBlock Text="来自通知" Style="{StaticResource FontCaption}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <Button Grid.Column="3" MinHeight="32" MinWidth="40"
                                                                Padding="8,0,8,0" Tag="{Binding Id}"
                                                                Click="RowMore_Click"
                                                                ToolTipService.ToolTip="更多操作"
                                                                AutomationProperties.Name="更多操作">
                                                            <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons"
                                                                      FontSize="16" />
                                                        </Button>
                                                    </Grid>

                                                    <!-- 内联编辑态：改时间 / 标题 / 提醒档位 -->
                                                    <Border Style="{StaticResource BodyPanelBorderStyle}"
                                                            Visibility="{Binding EditVisibility}">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="改时间或改提醒档位后，已触发的提醒会重新计时（后端会清空 fired[]）。"
                                                                       Style="{StaticResource FontCaption}" TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Grid.Column="0"
                                                                         Text="{Binding EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         PlaceholderText="标题" MinHeight="32" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding EditDue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         PlaceholderText="2026-11-05T14:30" MinHeight="32" />
                                                                <TextBox Grid.Column="2"
                                                                         Text="{Binding EditRemind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         PlaceholderText="1440,120" MinHeight="32" />
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                                <Button Content="取消" MinHeight="32" Tag="{Binding Id}"
                                                                        Click="EditCancel_Click" />
                                                                <Button Content="保存" MinHeight="32"
                                                                        Style="{StaticResource AccentButtonStyle}"
                                                                        Tag="{Binding Id}" Click="EditSave_Click" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空态 -->
                <StackPanel x:Name="EmptyState" Spacing="8" Margin="0,40,0,40"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="40" Opacity="0.5"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="还没有日程。" Style="{StaticResource FontBodyStrong}" HorizontalAlignment="Center" />
                    <TextBlock Text="点「＋ 手动添加日程」，或者在「通知」里把某条通知一键加入日程。"
                               Style="{StaticResource FontCaption}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="手动添加日程" MinHeight="32" Click="EmptyAdd_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
