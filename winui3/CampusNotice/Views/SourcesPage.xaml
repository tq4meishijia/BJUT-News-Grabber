<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CampusNotice.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CampusNotice.Controls"
    xmlns:helpers="using:CampusNotice.Helpers">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolVis" />
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolVis" Invert="True" />
        <helpers:StringToVisibilityConverter x:Key="StringVis" />
    </Page.Resources>

    <Grid x:Name="PageRoot" MaxWidth="940" HorizontalAlignment="Left" Padding="24,8,24,32">
        <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">

                <!-- 内联新增表单（字段多，不用 ContentDialog） -->
                <Border x:Name="AddForm" Style="{StaticResource CardBorderStyle}" Padding="16"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="添加数据源" Style="{StaticResource FontSectionTitle}" />
                        <controls:SourceEditor x:Name="AddEditor" />
                        <TextBlock x:Name="AddError" Style="{StaticResource FontCaption}"
                                   Foreground="{ThemeResource InfoBarErrorBrush}"
                                   Visibility="Collapsed" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="取消" MinHeight="32" Click="AddCancel_Click" />
                            <Button Content="添加" MinHeight="32" Style="{StaticResource AccentButtonStyle}"
                                    Click="AddSave_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 数据源卡片流 -->
                <ItemsControl x:Name="SourceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" MinHeight="88" Margin="0,0,0,8"
                                    Opacity="{Binding Opacity}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <!-- 顶部 4px 健康状态条（色 + 图标 + 文字三者齐备） -->
                                    <Border Grid.Row="0" Background="{Binding StatusBrush}"
                                            CornerRadius="8,8,0,0" />

                                    <StackPanel Grid.Row="1" Padding="12,8,12,10" Spacing="8">
                                        <!-- 首行：启用开关 / 名称 / 类型 / 状态 / 登录态 -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleSwitch Grid.Column="0" MinWidth="60" MinHeight="32"
                                                          IsOn="{Binding Enabled, Mode=OneWay}"
                                                          Tag="{Binding Id}" Toggled="Enabled_Toggled"
                                                          OnContent="" OffContent=""
                                                          AutomationProperties.Name="{Binding AutomationName}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource FontCardTitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Style="{StaticResource ChipBorderStyle}">
                                                        <TextBlock Text="{Binding Type}" Style="{StaticResource FontCaption}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Style="{StaticResource ChipBorderStyle}"
                                                            Background="{Binding StatusSubtleBrush}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="{Binding StatusIcon}"
                                                                      FontFamily="Segoe Fluent Icons" FontSize="12"
                                                                      Foreground="{Binding StatusBrush}" />
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       Style="{StaticResource FontCaption}"
                                                                       Foreground="{Binding StatusBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- D2：loginExpired 用 Warning 橙 + 必有「重新登录」动作，非红 -->
                                                    <Border Style="{StaticResource ChipBorderStyle}"
                                                            Visibility="{Binding LoginExpiredVisibility}"
                                                            Background="{ThemeResource SourceLoginExpiredSubtleBrush}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons"
                                                                      FontSize="12"
                                                                      Foreground="{ThemeResource SourceLoginExpiredBrush}" />
                                                            <TextBlock Text="Cookie 已失效" Style="{StaticResource FontCaption}"
                                                                       Foreground="{ThemeResource SourceLoginExpiredBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource ChipBorderStyle}"
                                                            Visibility="{Binding CookieOkVisibility}"
                                                            Background="{ThemeResource SourceCookieOkSubtleBrush}">
                                                        <TextBlock Text="已存 Cookie" Style="{StaticResource FontCaption}"
                                                                   Foreground="{ThemeResource SourceCookieOkBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource ChipBorderStyle}"
                                                            Visibility="{Binding NoCookieVisibility}">
                                                        <TextBlock Text="无需登录" Style="{StaticResource FontCaption}" />
                                                    </Border>
                                                    <HyperlinkButton Content="重新登录" Padding="4,0,4,0" FontSize="12"
                                                                     Tag="{Binding Id}" Click="Relogin_Click"
                                                                     Visibility="{Binding LoginExpiredVisibility}"
                                                                     AutomationProperties.Name="重新登录，用已保存的校园账号更新 Cookie" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FooterMeta}"
                                                       Style="{StaticResource FontCaption}" VerticalAlignment="Top"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>

                                        <!-- 次行：URL + 备注 -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Url}" Style="{StaticResource FontCaption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource FontCaption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Note, Converter={StaticResource StringVis}}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="测试" MinHeight="32" Tag="{Binding Id}"
                                                        Click="Test_Click" AutomationProperties.Name="测试数据源" />
                                                <Button Content="编辑" MinHeight="32" Tag="{Binding Id}"
                                                        Click="Edit_Click" AutomationProperties.Name="编辑数据源" />
                                                <Button Content="删除" MinHeight="32" Tag="{Binding Id}"
                                                        Click="Delete_Click"
                                                        Foreground="{ThemeResource NetworkErrorBrush}"
                                                        AutomationProperties.Name="删除数据源（需二次确认）" />
                                                <Button MinHeight="32" MinWidth="36" Padding="6,0,6,0"
                                                        Tag="{Binding Id}" Click="OpenUrl_Click"
                                                        ToolTipService.ToolTip="打开数据源网址"
                                                        AutomationProperties.Name="打开数据源网址">
                                                    <FontIcon Glyph="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 内联错误（测试失败 / 校验失败），失败仍应用返回 state -->
                                        <TextBlock Text="{Binding InlineError}" Style="{StaticResource FontCaption}"
                                                   Foreground="{ThemeResource InfoBarErrorBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding InlineErrorVisibility}" />

                                        <!-- source.test 成功：内联 preview（标题 + 日期 + 链接，≤5 条） -->
                                        <Border Style="{StaticResource BodyPanelBorderStyle}"
                                                Visibility="{Binding PreviewVisibility}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource FontBodyStrong}" />
                                                <ItemsControl ItemsSource="{Binding Preview}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnSpacing="8" Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                                           Style="{StaticResource FontCaption}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Date}"
                                                                           Style="{StaticResource FontCaption}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- 内联可折叠编辑卡（10+ 字段不用 ContentDialog） -->
                                        <Border Style="{StaticResource BodyPanelBorderStyle}"
                                                Visibility="{Binding EditVisibility}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="编辑数据源（隐藏字段保留原值，Cookie 留空表示不修改）"
                                                           Style="{StaticResource FontCaption}" TextWrapping="Wrap" />
                                                <controls:SourceEditor />
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button Content="取消" MinHeight="32" Tag="{Binding Id}"
                                                            Click="EditCancel_Click" />
                                                    <Button Content="保存" MinHeight="32"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            Tag="{Binding Id}" Click="EditSave_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空态 -->
                <StackPanel x:Name="EmptyState" Spacing="8" Margin="0,40,0,40"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="40" Opacity="0.5"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="还没有数据源。" Style="{StaticResource FontBodyStrong}" HorizontalAlignment="Center" />
                    <TextBlock Text="点「＋ 添加数据源」，填一个校内门户的列表页地址。"
                               Style="{StaticResource FontCaption}" HorizontalAlignment="Center" />
                    <Button Content="添加第一个数据源" MinHeight="32" Click="EmptyAdd_Click" />
                </StackPanel>

                <!-- 底部 12px 说明区（最弱层级，单行 ≤80 字符） -->
                <StackPanel Spacing="4" Margin="0,16,0,0">
                    <TextBlock Text="· 校内网 / WebVPN 才能访问的门户，请在浏览器 F12 复制登录态 Cookie 后填入。" Style="{StaticResource FontCaption}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="· DNS 覆盖只换解析 IP，仍用原域名做 TLS 校验；接口型门户请改「JSON 接口」并填 itemsPath。" Style="{StaticResource FontCaption}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="· 翻页模板用 {n} 表示页码；详情 URL 模板可用 {id} / {url} 占位。" Style="{StaticResource FontCaption}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="· 浏览器里直接打开接口看到「请登录」是正常的，与程序保存的 Cookie 不是同一份。" Style="{StaticResource FontCaption}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
