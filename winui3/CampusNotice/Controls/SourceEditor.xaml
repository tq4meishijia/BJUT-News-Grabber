<?xml version="1.0" encoding="utf-8"?>
<!--
  数据源字段编辑器（UX §5.2 type 显隐矩阵）。
  新增表单与卡内内联编辑共用同一份控件，避免两套字段走样。
  显隐由 SourceViewModel.Type 驱动（编辑时 SetEditType 同步更新），
  **切换 type 不清空已存字段值**：隐藏字段不渲染，保存时不显式传空字符串。
  cookie 一律 PasswordBox，留空 = 不修改，绝不回显已存明文。
-->
<UserControl
    x:Class="CampusNotice.Controls.SourceEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="12" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FontCaption}" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" MinHeight="32"
                     Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="留空则用网址域名" AutomationProperties.Name="数据源名称" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="列表页/接口地址 *" Style="{StaticResource FontCaption}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" MinHeight="32"
                     Text="{Binding EditUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="https://..." AutomationProperties.Name="数据源地址，必须 http 或 https 开头" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="解析方式" Style="{StaticResource FontCaption}" VerticalAlignment="Center" />
            <ComboBox x:Name="TypeCombo" Grid.Row="2" Grid.Column="1" MinHeight="32"
                      HorizontalAlignment="Stretch" SelectionChanged="TypeCombo_SelectionChanged"
                      AutomationProperties.Name="解析方式，仅 html rss json 三种">
                <ComboBoxItem Content="HTML 列表页" Tag="html" />
                <ComboBoxItem Content="RSS / Atom" Tag="rss" />
                <ComboBoxItem Content="JSON 接口" Tag="json" />
            </ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="登录态 Cookie" Style="{StaticResource FontCaption}" VerticalAlignment="Center" />
            <PasswordBox x:Name="CookieBox" Grid.Row="3" Grid.Column="1" MinHeight="32"
                         PasswordChanged="CookieBox_PasswordChanged"
                         PlaceholderText="已保存（留空不修改）"
                         AutomationProperties.Name="登录态 Cookie，不回显明文" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="DNS 覆盖 IP" Style="{StaticResource FontCaption}" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" MinHeight="32"
                     Text="{Binding EditResolveIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="域名解析不到时填，可选" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="备注" Style="{StaticResource FontCaption}" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" MinHeight="32"
                     Text="{Binding EditNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="≤300 字" />

            <!-- HTML 专用 -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="链接匹配正则" Style="{StaticResource FontCaption}"
                       VerticalAlignment="Center" Visibility="{Binding HtmlFieldsVisibility}" />
            <TextBox Grid.Row="6" Grid.Column="1" MinHeight="32"
                     Text="{Binding EditLinkPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="info/10 或 tzgg" Visibility="{Binding HtmlFieldsVisibility}" />

            <!-- 翻页：html / json 通用 -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="翻页模板 {n}" Style="{StaticResource FontCaption}"
                       VerticalAlignment="Center" Visibility="{Binding PagingVisibility}" />
            <Grid Grid.Row="7" Grid.Column="1" ColumnSpacing="8" Visibility="{Binding PagingVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" MinHeight="32"
                         Text="{Binding EditPageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="https://...page={n}" />
                <TextBox Grid.Column="1" MinHeight="32"
                         Text="{Binding EditPages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="页数 1–5" AutomationProperties.Name="页数，1 到 5" />
            </Grid>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="详情 URL 模板" Style="{StaticResource FontCaption}"
                       VerticalAlignment="Center" Visibility="{Binding PagingVisibility}" />
            <TextBox Grid.Row="8" Grid.Column="1" MinHeight="32"
                     Text="{Binding EditDetailUrlTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{id} / {url} 占位" Visibility="{Binding PagingVisibility}" />

            <!-- JSON 专用 -->
            <TextBlock Grid.Row="9" Grid.Column="0" Text="条目路径 itemsPath" Style="{StaticResource FontCaption}"
                       VerticalAlignment="Center" Visibility="{Binding JsonFieldsVisibility}" />
            <TextBox Grid.Row="9" Grid.Column="1" MinHeight="32"
                     Text="{Binding EditItemsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="d.data" Visibility="{Binding JsonFieldsVisibility}" />

            <TextBlock Grid.Row="10" Grid.Column="0" Text="链接拼接模板" Style="{StaticResource FontCaption}"
                       VerticalAlignment="Center" Visibility="{Binding JsonFieldsVisibility}" />
            <TextBox Grid.Row="10" Grid.Column="1" MinHeight="32"
                     Text="{Binding EditUrlTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="相对链接补全" Visibility="{Binding JsonFieldsVisibility}" />

            <TextBlock Grid.Row="11" Grid.Column="0" Text="正文路径 contentPath" Style="{StaticResource FontCaption}"
                       VerticalAlignment="Center" Visibility="{Binding JsonFieldsVisibility}" />
            <TextBox Grid.Row="11" Grid.Column="1" MinHeight="32"
                     Text="{Binding EditContentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="详情接口 JSON 正文字段路径" Visibility="{Binding JsonFieldsVisibility}" />

            <TextBlock Grid.Row="12" Grid.Column="0" Text="字段映射 map (JSON)" Style="{StaticResource FontCaption}"
                       VerticalAlignment="Center" Visibility="{Binding JsonFieldsVisibility}" />
            <TextBox Grid.Row="12" Grid.Column="1" MinHeight="32" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="80"
                     Text="{Binding EditMap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText='{"title":"title","url":"link"}'
                     Visibility="{Binding JsonFieldsVisibility}" />
        </Grid>
    </StackPanel>
</UserControl>
