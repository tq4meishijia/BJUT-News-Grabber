<?xml version="1.0" encoding="utf-8"?>
<!--
  重要度徽标（视觉规范 §7.4 / UX §3.1）。
  硬性要求：必须同时具备「档位文字 + score 数字 + 形状」，绝不只用颜色。
  四档形状：实心圆 / 实心菱形 / 空心圆 / 小方点；未评分无形状。
  score = 0 / 缺失 → 「未评分」，绝不显示为红色。
  AutomationProperties.Name 由 code-behind 写完整「重要度 78 分，重要」。
-->
<UserControl
    x:Class="CampusNotice.Controls.ScoreBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="Root" Height="20" CornerRadius="4" Padding="8,0,8,0"
            HorizontalAlignment="Left" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Grid Width="8" Height="8" VerticalAlignment="Center">
                <!-- 实心圆（重要 70–100） -->
                <Border x:Name="SolidCircle" Width="8" Height="8" CornerRadius="4"
                        Visibility="Collapsed" />
                <!-- 实心菱形（关注 50–69） -->
                <Border x:Name="SolidDiamond" Width="7" Height="7" CornerRadius="1"
                        Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45" />
                    </Border.RenderTransform>
                </Border>
                <!-- 空心圆（一般 35–49） -->
                <Border x:Name="HollowCircle" Width="8" Height="8" CornerRadius="4"
                        BorderThickness="1" Background="Transparent" Visibility="Collapsed" />
                <!-- 小方点（低 0–34） -->
                <Border x:Name="SmallSquare" Width="6" Height="6" CornerRadius="0"
                        Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="Label" Text="未评分" Style="{StaticResource FontOverline}" />
        </StackPanel>
    </Border>
</UserControl>
