<?xml version="1.0" encoding="utf-8"?>
<!--
  通知卡片（视觉规范 §7.3 / UX §3）。
  不透明实色 + 1px 描边 + 圆角 8 + **零投影**；未读靠左 3px 竖条 + 标题字重 + 实心圆点，
  已读去竖条去圆点、标题 Regular，不给整卡降透明度。行 5 只外露主操作，其余收进 More Flyout。
-->
<UserControl
    x:Class="CampusNotice.Controls.NoticeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CampusNotice.Controls"
    xmlns:helpers="using:CampusNotice.Helpers">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolVis" />
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolVis" Invert="True" />
        <helpers:StringToVisibilityConverter x:Key="StringVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}" MinHeight="96" Padding="16"
            Visibility="{Binding IsHidden, Converter={StaticResource InverseBoolVis}}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 未读 / 重要度左 3px 竖条 -->
            <Border Grid.Column="0" Width="3" CornerRadius="2"
                    Background="{Binding FillBrush}"
                    Visibility="{Binding ReadStripVisibility}" />

            <StackPanel Grid.Column="1" Spacing="6">

                <!-- 行 1：重要度徽标 + 标题 + chip 组 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:ScoreBadge Grid.Column="0" Score="{Binding Score}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- 未读：SemiBold；已读：Regular（不靠透明度表意） -->
                        <TextBlock Text="{Binding Title}" Style="{StaticResource FontCardTitle}"
                                   TextDecorations="Underline" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Read, Converter={StaticResource InverseBoolVis}}"
                                   Tapped="Title_Tapped"
                                   AutomationProperties.Name="打开通知原文并标为已读" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource FontCardTitleRead}"
                                   TextDecorations="Underline" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Read, Converter={StaticResource BoolVis}}"
                                   Tapped="Title_Tapped"
                                   AutomationProperties.Name="打开通知原文" />
                        <!-- 8px 实心未读圆点 -->
                        <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                Background="{Binding FillBrush}"
                                Visibility="{Binding Read, Converter={StaticResource InverseBoolVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Style="{StaticResource ChipBorderStyle}"
                                Visibility="{Binding Read, Converter={StaticResource InverseBoolVis}}">
                            <TextBlock Text="未读" Style="{StaticResource FontCaption}" />
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}"
                                Visibility="{Binding AiText, Converter={StaticResource StringVis}}">
                            <TextBlock Text="AI 摘要" Style="{StaticResource FontCaption}" />
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}"
                                Visibility="{Binding DeadlineText, Converter={StaticResource StringVis}}">
                            <TextBlock Text="{Binding DeadlineText}" Style="{StaticResource FontCaption}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 行 2：meta + chip -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding MetaLine}" Style="{StaticResource FontCaption}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding ContactText, Converter={StaticResource StringVis}}">
                        <TextBlock Text="{Binding ContactText}" Style="{StaticResource FontCaption}" />
                    </Border>
                    <Border Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding TagsText, Converter={StaticResource StringVis}}">
                        <TextBlock Text="{Binding TagsText}" Style="{StaticResource FontCaption}" />
                    </Border>
                </StackPanel>

                <!-- 行 3：AI/规则一句话摘要，最多 2 行 -->
                <TextBlock Text="{Binding Summary}" Style="{StaticResource FontBody}"
                           MaxLines="2" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Summary, Converter={StaticResource StringVis}}" />

                <!-- 行 4：「对我有什么用」清单（默认 1-2 条，可展开更多） -->
                <StackPanel Spacing="2" Visibility="{Binding UsefulText, Converter={StaticResource StringVis}}">
                    <TextBlock x:Name="UsefulTextBlock" Text="{Binding UsefulText}" Style="{StaticResource FontCaption}"
                               MaxLines="2" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="UsefulToggle" Content="展开更多" Padding="0" FontSize="12"
                                     Click="UsefulToggle_Click" />
                </StackPanel>

                <!-- 行 5：操作区。主操作外露，其余收进 More -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding InlineError}" Style="{StaticResource FontCaption}"
                               Foreground="{ThemeResource InfoBarErrorBrush}"
                               Visibility="{Binding InlineErrorVisibility}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <!-- AI 摘要 / 测试类的按钮内 16px loading（§7.12），按钮宽度不跳动 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    Visibility="{Binding IsSummarizing, Converter={StaticResource BoolVis}}">
                            <ProgressRing Width="16" Height="16" IsActive="True" />
                            <TextBlock Text="摘要中…" Style="{StaticResource FontCaption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="AddScheduleButton" Content="{Binding ScheduleButtonText}"
                                Style="{StaticResource AccentButtonStyle}" MinHeight="32"
                                Click="AddSchedule_Click"
                                AutomationProperties.Name="加入日程" />
                        <Button x:Name="MoreButton" MinHeight="32" MinWidth="40" Padding="8,0,8,0"
                                Click="More_Click" ToolTipService.ToolTip="更多操作"
                                AutomationProperties.Name="更多操作">
                            <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 展开正文：二级面板底、圆角 6、MaxHeight 340 可滚动 -->
                <Border Style="{StaticResource BodyPanelBorderStyle}" MaxHeight="340"
                        Visibility="{Binding BodyVisibility}">
                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Content}" Style="{StaticResource FontCaption}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
